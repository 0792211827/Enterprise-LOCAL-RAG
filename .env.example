# Enterprise Local RAG - Environment Configuration (EXAMPLE)
# Copy this file to .env and adjust values as needed.
# The platform is local-first: it runs with NO external AI APIs.

# ── Application ────────────────────────────────────────────────
DEBUG=true
ENVIRONMENT=development

# ── PostgreSQL Database ────────────────────────────────────────
POSTGRES_DATABASE_URL=postgresql://user:pass@postgres:5432/rag_db

# ── OpenSearch (BM25 + vector + hybrid RRF) ────────────────────
OPENSEARCH__HOST=http://opensearch:9200
OPENSEARCH__INDEX_NAME=rag-documents
OPENSEARCH__CHUNK_INDEX_SUFFIX=chunks
OPENSEARCH__MAX_TEXT_SIZE=1000000
OPENSEARCH__VECTOR_DIMENSION=1024
OPENSEARCH__VECTOR_SPACE_TYPE=cosinesimil
OPENSEARCH__RRF_PIPELINE_NAME=hybrid-rrf-pipeline
OPENSEARCH__HYBRID_SEARCH_SIZE_MULTIPLIER=2

# ── Text Chunking (section-aware) ──────────────────────────────
CHUNKING__CHUNK_SIZE=600
CHUNKING__OVERLAP_SIZE=100
CHUNKING__MIN_CHUNK_SIZE=100
CHUNKING__SECTION_BASED=true

# ── Embeddings (LOCAL by default, no external API key) ──────────
# provider: huggingface | ollama | openai-compatible
EMBEDDING__PROVIDER=huggingface
EMBEDDING__MODEL=BAAI/bge-m3
EMBEDDING__DIMENSION=1024
# For ollama / openai-compatible providers:
EMBEDDING__ENDPOINT=http://ollama:11434
EMBEDDING__API_KEY=
# Device: "", cpu, cuda, mps ("" = auto-detect)
EMBEDDING__DEVICE=
EMBEDDING__NORMALIZE=true

# ── LLM (LOCAL by default) ─────────────────────────────────────
# provider: ollama | openai-compatible
LLM__PROVIDER=ollama
LLM__ENDPOINT=http://ollama:11434
LLM__MODEL=llama3.2:1b
LLM__API_KEY=
LLM__TIMEOUT=300

# Legacy Ollama variables (still honored by the Ollama LLM provider)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=300

# ── VLM (OPTIONAL, off by default) ─────────────────────────────
VLM__ENABLED=false
VLM__PROVIDER=ollama
VLM__ENDPOINT=http://ollama:11434
VLM__MODEL=qwen2.5-vl
VLM__API_KEY=

# ── Document Parser ────────────────────────────────────────────
PDF_PARSER__MAX_PAGES=30
PDF_PARSER__MAX_FILE_SIZE_MB=20
PDF_PARSER__DO_OCR=false
PDF_PARSER__DO_TABLE_STRUCTURE=true

# ── Redis Cache ────────────────────────────────────────────────
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB=0
REDIS__TTL_HOURS=6

# ── Langfuse (self-hosted, local monitoring) ───────────────────
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_FLUSH_AT=15
LANGFUSE_FLUSH_INTERVAL=1.0
LANGFUSE_DEBUG=false

# Langfuse server (docker-compose) - CHANGE THESE IN PRODUCTION
LANGFUSE_NEXTAUTH_SECRET=changeme-v3-nextauth-secret-min-32-chars-recommended
LANGFUSE_SALT=changeme-v3-salt-min-32-chars-recommended-for-security
LANGFUSE_ENCRYPTION_KEY=changeme-v3-encryption-key-64-hex-chars-required-see-docs
LANGFUSE_REDIS_PASSWORD=langfuse_redis_password
LANGFUSE_MINIO_ACCESS_KEY=langfuse_minio
LANGFUSE_MINIO_SECRET_KEY=langfuse_minio_secret
