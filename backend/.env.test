# Test environment configuration
DEBUG=true
ENVIRONMENT=development

# Test Database URL (localhost)
POSTGRES_DATABASE_URL=postgresql://user:pass@localhost:5432/test_db

# Test External Services
OPENSEARCH__HOST=http://localhost:9200
OLLAMA_HOST=http://localhost:11434

# Local-first model providers
EMBEDDING__PROVIDER=huggingface
EMBEDDING__MODEL=BAAI/bge-m3
LLM__PROVIDER=ollama
LLM__MODEL=llama3.2:1b
VLM__ENABLED=false

# Keep the suite hermetic: Settings also reads the repo-root .env, and a
# developer's copy of .env.example (placeholder Langfuse keys, local auth
# config) must not change what the tests observe. Empty values here override it.
LANGFUSE__PUBLIC_KEY=
LANGFUSE__SECRET_KEY=
AUTH__MODE=disabled
